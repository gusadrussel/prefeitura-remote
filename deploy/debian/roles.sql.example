-- TEMPLATE for a NEW isolated database, executed by its dedicated migrator owner.
-- Do not apply to an existing service without an approved change/backup plan.
-- Operator provisions LOGIN credentials outside tracked SQL, never with defaults.
-- Create/migrate the schema as the migrator FIRST, then grant app DML only.
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO prefeitura_app;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA public TO prefeitura_app;
GRANT DELETE ON TABLE public.activation_codes TO prefeitura_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO prefeitura_app;
ALTER DEFAULT PRIVILEGES FOR ROLE prefeitura_migrator IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE ON TABLES TO prefeitura_app;
ALTER DEFAULT PRIVILEGES FOR ROLE prefeitura_migrator IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO prefeitura_app;
